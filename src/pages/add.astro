---
import Base from '../layouts/Base.astro';
import { REPO } from '../config';
---

<Base
  title="Add your /brag page"
  description="Add yourself to the directory by opening a pull request — pre-filled for you."
>
  <section class="wrap add">
    <a href="/" class="add__back">← Back to the directory</a>
    <h1 class="add__title">Add your /brag page</h1>
    <p class="add__intro">
      Fill this in and hit the button. It opens GitHub with a new file already
      written for you — review it, commit, and GitHub walks you through opening a
      pull request. No account setup beyond a GitHub login, and nothing is saved
      until a maintainer merges your PR.
    </p>

    <div class="add__grid">
      <form id="brag-form" novalidate>
        <div class="field">
          <label for="name">Name</label>
          <input type="text" id="name" name="name" maxlength="80" required
            placeholder="Ada Lovelace" />
        </div>

        <div class="field">
          <label for="url">Link to your /brag page</label>
          <input type="url" id="url" name="url" required
            placeholder="https://yoursite.com/brag" />
          <p class="hint">Where your brag lives. A full URL including https://</p>
        </div>

        <div class="field">
          <label for="description">Who you are / what you do</label>
          <textarea id="description" name="description" maxlength="200" required
            placeholder="One or two sentences."></textarea>
          <p class="hint">
            <span id="counter">0</span>/200 characters
          </p>
        </div>

        <p class="error" id="error" role="alert" hidden></p>

        <button type="submit" class="btn btn-primary" id="submit">
          Open a pre-filled pull request →
        </button>
      </form>

      <aside class="preview">
        <p class="preview__label">This is the file that will be created:</p>
        <pre class="preview__code"><span class="preview__path" id="prev-path">src/content/brags/your-name.json</span><code id="prev-json">{`{
  "name": "",
  "url": "",
  "description": ""
}`}</code></pre>
      </aside>
    </div>
  </section>
</Base>

<script define:vars={{ repo: REPO }}>
  const form = document.getElementById('brag-form');
  const nameEl = document.getElementById('name');
  const urlEl = document.getElementById('url');
  const descEl = document.getElementById('description');
  const counter = document.getElementById('counter');
  const errorEl = document.getElementById('error');
  const prevJson = document.getElementById('prev-json');
  const prevPath = document.getElementById('prev-path');

  // turn a name into a safe filename: "Ada Lovelace" -> "ada-lovelace"
  function slugify(s) {
    return s
      .toLowerCase()
      .trim()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '') // strip accents
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '');
  }

  function currentEntry() {
    return {
      name: nameEl.value.trim(),
      url: urlEl.value.trim(),
      description: descEl.value.trim(),
    };
  }

  function refreshPreview() {
    const entry = currentEntry();
    prevJson.textContent = JSON.stringify(entry, null, 2);
    const slug = slugify(entry.name) || 'your-name';
    prevPath.textContent = `${repo.contentPath}/${slug}.json`;
    counter.textContent = String(descEl.value.length);
  }

  function showError(msg) {
    errorEl.textContent = msg;
    errorEl.hidden = false;
  }

  [nameEl, urlEl, descEl].forEach((el) =>
    el.addEventListener('input', () => {
      errorEl.hidden = true;
      refreshPreview();
    })
  );
  refreshPreview();

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const entry = currentEntry();

    if (!entry.name) return showError('Please enter your name.');
    try {
      new URL(entry.url);
    } catch {
      return showError('Please enter a valid URL, including https://');
    }
    if (!entry.description) return showError('Please add a short description.');
    if (entry.description.length > 200)
      return showError('Description must be 200 characters or fewer.');

    const slug = slugify(entry.name);
    const fileContents = JSON.stringify(entry, null, 2) + '\n';
    const filename = `${repo.contentPath}/${slug}.json`;

    // GitHub "create new file" deep link, pre-filled. For contributors without
    // write access, GitHub automatically offers to fork + open a PR.
    const ghUrl =
      `https://github.com/${repo.owner}/${repo.name}/new/${repo.branch}` +
      `?filename=${encodeURIComponent(filename)}` +
      `&value=${encodeURIComponent(fileContents)}`;

    window.open(ghUrl, '_blank', 'noopener');
  });
</script>

<style>
  .add {
    padding-block: var(--space-5);
    max-width: 920px;
  }
  .add__back {
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }
  .add__title {
    font-size: var(--text-2xl);
    margin-top: var(--space-2);
  }
  .add__intro {
    max-width: 56ch;
    margin-top: var(--space-2);
    color: var(--color-ink-soft);
  }
  .add__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }
  @media (min-width: 800px) {
    .add__grid {
      grid-template-columns: 1.1fr 0.9fr;
      align-items: start;
    }
  }
  .field {
    margin-bottom: var(--space-3);
  }
  .error {
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: 600;
    margin-bottom: var(--space-2);
  }
  .preview {
    position: sticky;
    top: 90px;
  }
  .preview__label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink-soft);
    margin-bottom: var(--space-1);
  }
  .preview__code {
    background: var(--color-ink);
    color: #f3eee2;
    border-radius: var(--radius);
    padding: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    overflow-x: auto;
    line-height: 1.5;
  }
  .preview__path {
    display: block;
    color: #b9b1a0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    padding-bottom: var(--space-1);
    margin-bottom: var(--space-1);
    font-size: var(--text-xs);
  }
</style>
