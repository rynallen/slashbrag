---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import BragCard from '../components/BragCard.astro';
import { SITE, REPO } from '../config';
import Logo from '../images/Logo-Wordmark.svg';
import heroBg from '../images/bg-hero-elevated-lines.webp';
import iconBuild from '../images/build.svg';
import iconCode from '../images/code.svg';
import iconTrophy from '../images/trophy.svg';
import iconWriting from '../images/writing.svg';
import iconSpeaker from '../images/speaker.svg';
import iconTeach from '../images/teach.svg';
import iconOne from '../images/one.svg';
import iconTwo from '../images/two.svg';
import iconFamily from '../images/family.svg';

// Pull every entry, then sort alphabetically by name.
// To randomize on each build instead, replace the sort with:
//   .sort(() => Math.random() - 0.5)
const entries = (await getCollection('brags')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name)
);
---

<Base>
  <section class="hero" style={`background-image: url(${heroBg.src})`}>
    <div class="wrap">
      <div class="hero__row">
        <img src={Logo.src} alt="Brag Directory" class="hero__logo" />
        <p class="hero__desc">a directory of <code class="brag-highlight">/brag</code> pages</p>
      </div>
      <nav class="tabs">
        <div class="tabs__inner">
          <button class="tab active" data-tab="about"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="tab__icon" height="20" width="20"><path d="M12 0a12 12 0 1 0 12 12A12 12 0 0 0 12 0Zm0.25 5a1.5 1.5 0 1 1 -1.5 1.5 1.5 1.5 0 0 1 1.5 -1.5Zm2.25 13.5h-4a1 1 0 0 1 0 -2h0.75a0.25 0.25 0 0 0 0.25 -0.25v-4.5a0.25 0.25 0 0 0 -0.25 -0.25h-0.75a1 1 0 0 1 0 -2h1a2 2 0 0 1 2 2v4.75a0.25 0.25 0 0 0 0.25 0.25h0.75a1 1 0 0 1 0 2Z" fill="currentColor"></path></svg> About</button>
          <button class="tab" data-tab="search"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="tab__icon" height="20" width="20"><path d="m23.69 22.28 -2.51 -2.51a0.24 0.24 0 0 1 0 -0.3 5.49 5.49 0 0 0 -3.37 -8.31 5.5 5.5 0 1 0 1.69 10 0.24 0.24 0 0 1 0.3 0l2.51 2.51a1 1 0 0 0 1.41 -1.41ZM16.52 20a3.5 3.5 0 1 1 3.5 -3.5 3.5 3.5 0 0 1 -3.5 3.5Z" fill="currentColor"></path><path d="M15.75 9.56a7 7 0 0 1 4.87 1.29 0.25 0.25 0 0 0 0.4 -0.19V4.52A1.5 1.5 0 0 0 19.52 3H9.63a0.5 0.5 0 0 1 -0.44 -0.28L8.24 0.85A1.49 1.49 0 0 0 6.9 0H1.52A1.5 1.5 0 0 0 0 1.52v15A1.5 1.5 0 0 0 1.52 18h7.86a0.24 0.24 0 0 0 0.24 -0.3A6.76 6.76 0 0 1 10 14a7 7 0 0 1 5.75 -4.44Z" fill="currentColor"></path></svg> Browse directory</button>
          <button class="tab tab--icon tab--right" data-tab="add" aria-label="Add yours"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="tab__icon" height="22" width="22"><path d="M12 24A12 12 0 1 0 0 12a12 12 0 0 0 12 12ZM6 11h4.75a0.25 0.25 0 0 0 0.25 -0.25V6a1 1 0 0 1 2 0v4.75a0.25 0.25 0 0 0 0.25 0.25H18a1 1 0 0 1 0 2h-4.75a0.25 0.25 0 0 0 -0.25 0.25V18a1 1 0 0 1 -2 0v-4.75a0.25 0.25 0 0 0 -0.25 -0.25H6a1 1 0 0 1 0 -2Z" fill="currentColor"></path></svg></button>
        </div>
      </nav>
    </div>
  </section>

  <div class="tab-panel active" id="panel-about">
    <section class="wrap about">
      <div class="about__grid">
        <div>
          <h2 class="about__title">You've done some cool sh*t!<br/>Feel free to brag a little.</h2>
          <p class="about__lead">
            A <code class="brag-highlight">/brag</code> page is a running list of accomplishments on your personal site — projects shipped, talks given, the work you're most proud of.
          </p>
          <ol class="about__steps">
            <li><img src={iconOne.src} alt="" class="about__step-icon" /> Create a <code class="brag-highlight">/brag</code> vanity URL on your personal site.</li>
            <li><img src={iconTwo.src} alt="" class="about__step-icon" /> <button type="button" class="about__steps-link" data-switch-tab="add">Link to it here</button> so the world can find it.</li>
          </ol>
        </div>
        <div class="about__ideas">
          <h3 class="about__ideas-title">What goes on a <code class="brag-highlight">/brag</code> page?</h3>
          <ul class="about__list">
            <li><img src={iconBuild.src} alt="" class="about__list-icon" /> Projects you shipped</li>
            <li><img src={iconSpeaker.src} alt="" class="about__list-icon" /> Talks or presentations you gave</li>
            <li><img src={iconCode.src} alt="" class="about__list-icon" /> Open source contributions</li>
            <li><img src={iconWriting.src} alt="" class="about__list-icon" /> Blog posts or articles you wrote</li>
            <li><img src={iconTrophy.src} alt="" class="about__list-icon" /> Promotions or role changes</li>
            <li><img src={iconTeach.src} alt="" class="about__list-icon" /> Mentoring or teaching wins</li>
            <li><img src={iconTrophy.src} alt="" class="about__list-icon" /> Awards or recognition</li>
            <li><img src={iconFamily.src} alt="" class="about__list-icon" /> Family & life wins</li>
            <li><img src={iconBuild.src} alt="" class="about__list-icon" /> Hard problems you solved</li>
          </ul>
        </div>
      </div>
    </section>
  </div>

  <div class="tab-panel" id="panel-search" hidden>
    <section class="wrap directory">
      <div class="directory__bar">
        <div class="directory__search">
          <label for="search" class="sr-only">Search the directory</label>
          <input
            type="text"
            id="search"
            placeholder="Search names or descriptions…"
            autocomplete="off"
          />
          <button type="button" id="search-clear" class="search-clear" hidden aria-label="Clear search">✕</button>
        </div>
        <button type="button" id="star-filter" class="star-filter" aria-pressed="false" aria-label="Show starred only">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
          </svg>
          <span class="star-filter__label">Starred</span>
          <span class="star-filter__count" id="star-count" hidden></span>
        </button>
      </div>

      <p class="directory__count">
        <span id="count">{entries.length}</span>
        {entries.length === 1 ? 'page' : 'pages'}
      </p>

      <div class="grid" id="grid">
        {entries.map((entry) => <BragCard {...entry.data} />)}
      </div>

      <p class="empty" id="empty" hidden>No pages match that search.</p>

      <button type="button" class="back-to-top" id="back-to-top" aria-label="Back to top">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" height="20" width="20" aria-hidden="true">
          <path d="M19.22 7.06 12.72 0.31a1 1 0 0 0 -1.42 0L4.78 7.06a1 1 0 0 0 1.44 1.38l4.78 -5V23a1 1 0 0 0 2 0V3.48l4.78 5a1 1 0 0 0 0.72 0.31 1 1 0 0 0 0.69 -0.28 1 1 0 0 0 0.03 -1.45Z" fill="currentColor"/>
        </svg>
        Back to top
      </button>
    </section>
  </div>

  <div class="tab-panel" id="panel-add" hidden>
    <section class="wrap add">
      <h2 class="add__title">Add your <code class="brag-highlight">/brag</code> page</h2>
      <p class="add__intro">
        Fill this in and hit the button. It opens GitHub with a new file already
        written for you — review it, commit, and open a pull request.
      </p>
      <div class="add__grid">
        <form id="brag-form" novalidate autocomplete="off">
          <div class="field">
            <label for="add-name">Name</label>
            <input type="text" id="add-name" name="name" maxlength="80" required placeholder="Ada Lovelace" />
          </div>
          <div class="field">
            <label for="add-url">Link to your <code class="brag-highlight">/brag</code> page</label>
            <input type="url" id="add-url" name="url" required placeholder="https://yoursite.com/brag" />
            <p class="hint">Where your brag lives. A full URL including https://</p>
          </div>
          <div class="field">
            <label for="add-description">Who you are / what you do</label>
            <textarea id="add-description" name="description" required placeholder="One or two sentences."></textarea>
          </div>
          <div class="field">
            <label for="add-github">GitHub username <span class="label-optional">(optional)</span></label>
            <div class="github-input-wrap">
              <span class="github-input-prefix">@</span>
              <input type="text" id="add-github" placeholder="username" autocomplete="off" />
              <img class="github-avatar-preview" id="github-avatar-preview" alt="" hidden />
            </div>
            <p class="hint">Used for your avatar</p>
          </div>
          <div class="field">
            <label for="add-tags-input">Tags</label>
            <div class="tag-input" id="tag-input">
              <div class="tag-input__tags" id="tag-list"></div>
              <input type="text" id="add-tags-input" placeholder="Type and press Enter…" autocomplete="off" />
            </div>
            <p class="hint">Add up to 5 tags (e.g. Design, React, Leadership)</p>
          </div>
          <p class="error" id="error" role="alert" hidden></p>
        </form>

        <aside class="preview">
          <p class="preview__label">Preview</p>
          <div class="preview__code">
            <pre class="preview__json" id="preview-json">{`{\n  "name": "",\n  "url": "",\n  "description": "",\n  "tags": []\n}`}</pre>
          </div>
          <div class="preview__actions">
            <button type="button" class="btn btn-ghost" id="copy-json">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              Copy JSON
            </button>
            <button type="submit" form="brag-form" class="btn btn-primary" id="submit">Open pull request →</button>
          </div>
        </aside>
      </div>
    </section>
  </div>
</Base>

<script>
  import { animate } from 'motion';
  import { REPO } from '../config';

  // --- Tabs ---
  const tabs = document.querySelectorAll<HTMLElement>('.tab');
  const panels = document.querySelectorAll<HTMLElement>('.tab-panel');

  function switchTab(name: string) {
    tabs.forEach(t => {
      const isActive = t.dataset.tab === name;
      t.classList.toggle('active', isActive);
      if (isActive) {
        animate(t, { y: [4, 0] }, { type: 'spring', bounce: 0.15, duration: 0.3 });
      }
    });
    panels.forEach(p => {
      const active = p.id === `panel-${name}`;
      if (active) {
        p.hidden = false;
        p.classList.add('active');
        animate(p, { opacity: [0, 1], y: [12, 0] }, { duration: 0.3, easing: 'ease-out' });
      } else {
        p.hidden = true;
        p.classList.remove('active');
      }
    });
  }

  tabs.forEach(t => {
    if (t.dataset.tab) t.addEventListener('click', () => switchTab(t.dataset.tab!));
  });
  document.querySelectorAll<HTMLElement>('[data-switch-tab]').forEach(el =>
    el.addEventListener('click', () => switchTab(el.dataset.switchTab!))
  );

  // --- Starred (localStorage) ---
  const STORAGE_KEY = 'brag-starred';

  function getStarred(): Set<string> {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      return new Set(raw ? JSON.parse(raw) : []);
    } catch {
      return new Set();
    }
  }

  function saveStarred(starred: Set<string>) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify([...starred]));
    } catch { /* storage full or blocked */ }
  }

  let starredCache = getStarred();

  function toggleStar(name: string): boolean {
    const isNowStarred = !starredCache.has(name);
    if (isNowStarred) starredCache.add(name);
    else starredCache.delete(name);
    saveStarred(starredCache);
    return isNowStarred;
  }

  // --- Fuzzy Search (Fuse.js) ---
  import Fuse from 'fuse.js';

  const input = document.getElementById('search') as HTMLInputElement;
  const clearBtn = document.getElementById('search-clear') as HTMLButtonElement;
  const starFilterBtn = document.getElementById('star-filter') as HTMLButtonElement;
  const starCountEl = document.getElementById('star-count');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.card'));
  const count = document.getElementById('count');
  const empty = document.getElementById('empty');

  let showStarredOnly = false;

  const fuseEntries = cards.map((card, i) => ({
    idx: i,
    name: card.dataset.name ?? '',
    desc: card.dataset.desc ?? '',
    tags: card.dataset.tags ?? '',
  }));

  const fuse = new Fuse(fuseEntries, {
    keys: [
      { name: 'name', weight: 2 },
      { name: 'tags', weight: 1.5 },
      { name: 'desc', weight: 1 },
    ],
    threshold: 0.4,
    ignoreLocation: true,
    minMatchCharLength: 2,
  });

  function applyFilter() {
    if (showStarredOnly) {
      let visible = 0;
      cards.forEach(card => {
        const name = card.dataset.name ?? '';
        const show = starredCache.has(name);
        card.hidden = !show;
        if (show) visible++;
      });
      if (count) count.textContent = String(visible);
      if (empty) {
        empty.hidden = visible !== 0;
        if (visible === 0) empty.textContent = 'No starred pages yet. Click the ★ on any card to save it.';
      }
      requestAnimationFrame(updateBackToTop);
      return;
    }

    const q = input.value.trim();
    clearBtn.hidden = q === '';
    if (q === '') {
      cards.forEach(c => c.hidden = false);
      if (count) count.textContent = String(cards.length);
      if (empty) empty.hidden = true;
      requestAnimationFrame(updateBackToTop);
      return;
    }
    const results = new Set(fuse.search(q).map(r => r.item.idx));
    let visible = 0;
    cards.forEach((card, i) => {
      const match = results.has(i);
      card.hidden = !match;
      if (match) visible++;
    });
    if (count) count.textContent = String(visible);
    if (empty) {
      empty.hidden = visible !== 0;
      if (visible === 0) empty.textContent = 'No pages match that search.';
    }
    requestAnimationFrame(updateBackToTop);
  }

  clearBtn?.addEventListener('click', () => {
    input.value = '';
    applyFilter();
    input.focus();
  });

  input?.addEventListener('input', applyFilter);

  // --- Star button init ---
  cards.forEach(card => {
    const btn = card.querySelector('.card__star') as HTMLButtonElement | null;
    if (!btn) return;
    const name = card.dataset.name ?? '';

    if (starredCache.has(name)) {
      btn.setAttribute('aria-pressed', 'true');
    }

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isNowStarred = toggleStar(name);
      btn.setAttribute('aria-pressed', String(isNowStarred));
      animate(btn, { scale: [1, 1.4, 1] }, { duration: 0.3, easing: 'ease-out' });
      updateStarCount();
      applyFilter();
    });
  });

  // --- Starred filter toggle ---
  function updateStarCount() {
    const n = starredCache.size;
    if (starCountEl) {
      starCountEl.textContent = String(n);
      starCountEl.hidden = n === 0;
    }
  }

  starFilterBtn?.addEventListener('click', () => {
    showStarredOnly = !showStarredOnly;
    starFilterBtn.setAttribute('aria-pressed', String(showStarredOnly));
    input.disabled = showStarredOnly;
    clearBtn.hidden = true;
    applyFilter();
    animate(starFilterBtn, { scale: [1, 1.06, 1] }, { duration: 0.2, easing: 'ease-out' });
  });

  updateStarCount();

  // --- Back to top ---
  const backToTop = document.getElementById('back-to-top');

  function updateBackToTop() {
    if (!backToTop) return;
    const scrollable = document.documentElement.scrollHeight > window.innerHeight + 100;
    backToTop.hidden = !scrollable;
  }

  backToTop?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
  updateBackToTop();
  window.addEventListener('resize', updateBackToTop);

  // --- Card click → open URL ---
  cards.forEach(card => {
    card.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('.card__star') || target.closest('.card__link')) return;
      const url = card.dataset.url;
      if (url) window.open(url, '_blank', 'noopener');
    });
  });

  // --- Add form ---
  const addForm = document.getElementById('brag-form');
  const addName = document.getElementById('add-name') as HTMLInputElement;
  const addUrl = document.getElementById('add-url') as HTMLInputElement;
  const addDesc = document.getElementById('add-description') as HTMLTextAreaElement;
  const addError = document.getElementById('error') as HTMLElement;
  const tagInput = document.getElementById('add-tags-input') as HTMLInputElement;
  const tagList = document.getElementById('tag-list')!;
  const tagWrap = document.getElementById('tag-input')!;
  const tags: string[] = [];
  const MAX_TAGS = 5;

  function renderTags() {
    tagList.innerHTML = '';
    tags.forEach((tag, i) => {
      const pill = document.createElement('span');
      pill.className = 'tag-pill';
      pill.innerHTML = `${tag}<button type="button" class="tag-pill__remove" aria-label="Remove ${tag}">✕</button>`;
      pill.querySelector('button')!.addEventListener('click', () => {
        tags.splice(i, 1);
        renderTags();
        refreshPreview();
        tagInput.focus();
      });
      tagList.appendChild(pill);
    });
  }

  function addTag(value: string) {
    const trimmed = value.trim();
    if (!trimmed || tags.length >= MAX_TAGS) return;
    if (tags.some(t => t.toLowerCase() === trimmed.toLowerCase())) return;
    tags.push(trimmed);
    renderTags();
    refreshPreview();
  }

  tagInput.addEventListener('keydown', (e) => {
    if ((e.key === 'Enter' || e.key === ',' || e.key === 'Tab') && tagInput.value.trim()) {
      e.preventDefault();
      addTag(tagInput.value.replace(',', ''));
      tagInput.value = '';
    }
    if (e.key === 'Backspace' && !tagInput.value && tags.length) {
      tags.pop();
      renderTags();
      refreshPreview();
    }
  });

  tagWrap.addEventListener('click', () => tagInput.focus());

  // --- GitHub username → avatar ---
  const githubInput = document.getElementById('add-github') as HTMLInputElement;
  const avatarPreview = document.getElementById('github-avatar-preview') as HTMLImageElement;
  let avatarUrl = '';
  let githubDebounce: ReturnType<typeof setTimeout>;

  githubInput?.addEventListener('input', () => {
    clearTimeout(githubDebounce);
    const username = githubInput.value.trim();
    if (!username) {
      avatarUrl = '';
      avatarPreview.hidden = true;
      refreshPreview();
      return;
    }
    githubDebounce = setTimeout(() => {
      const testUrl = `https://github.com/${username}.png?size=88`;
      const img = new Image();
      img.onload = () => {
        avatarUrl = `https://github.com/${username}.png`;
        avatarPreview.src = testUrl;
        avatarPreview.hidden = false;
        refreshPreview();
      };
      img.onerror = () => {
        avatarUrl = '';
        avatarPreview.hidden = true;
        refreshPreview();
      };
      img.src = testUrl;
    }, 400);
  });

  function slugify(s: string) {
    return s.toLowerCase().trim().normalize('NFD')
      .replace(/[̀-ͯ]/g, '')
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '');
  }

  const previewJson = document.getElementById('preview-json');
  const previewPath = document.getElementById('preview-path');
  const copyBtn = document.getElementById('copy-json');

  function refreshPreview() {
    const entry: Record<string, unknown> = {
      name: addName.value.trim(),
      url: addUrl.value.trim(),
      description: addDesc.value.trim(),
    };
    if (avatarUrl) entry.avatar = avatarUrl;
    if (tags.length) entry.tags = tags;
    if (previewJson) previewJson.textContent = JSON.stringify(entry, null, 2);
    if (previewPath) {
      const slug = slugify(entry.name) || 'your-name';
      previewPath.textContent = `${REPO.contentPath}/${slug}.json`;
    }
  }

  [addName, addUrl, addDesc].forEach(el =>
    el?.addEventListener('input', refreshPreview)
  );

  copyBtn?.addEventListener('click', () => {
    const entry: Record<string, unknown> = {
      name: addName.value.trim(),
      url: addUrl.value.trim(),
      description: addDesc.value.trim(),
    };
    if (avatarUrl) entry.avatar = avatarUrl;
    if (tags.length) entry.tags = tags;
    navigator.clipboard.writeText(JSON.stringify(entry, null, 2) + '\n');
    const original = copyBtn.innerHTML;
    copyBtn.textContent = 'Copied!';
    setTimeout(() => { copyBtn.innerHTML = original; }, 1500);
  });

  addForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = addName.value.trim();
    const url = addUrl.value.trim();
    const desc = addDesc.value.trim();

    addError.hidden = true;
    if (!name) { addError.textContent = 'Please enter your name.'; addError.hidden = false; return; }
    if (!url) { addError.textContent = 'Please enter a URL.'; addError.hidden = false; return; }
    if (!desc) { addError.textContent = 'Please add a short description.'; addError.hidden = false; return; }

    const data: Record<string, unknown> = { name, url, description: desc };
    if (avatarUrl) data.avatar = avatarUrl;
    if (tags.length) data.tags = [...tags];
    const entry = JSON.stringify(data, null, 2) + '\n';
    const filename = `${REPO.contentPath}/${slugify(name)}.json`;
    const ghUrl = `https://github.com/${REPO.owner}/${REPO.name}/new/${REPO.branch}?filename=${encodeURIComponent(filename)}&value=${encodeURIComponent(entry)}`;
    window.open(ghUrl, '_blank', 'noopener');
    addForm.reset();
    avatarUrl = '';
    avatarPreview.hidden = true;
    tags.length = 0;
    renderTags();
    refreshPreview();
  });
</script>

<style>
  .brag-highlight {
    font-family: var(--font-mono);
    font-size: 0.85em;
    font-weight: 700;
    color: #1C80CB;
    background: rgba(28, 128, 203, 0.12);
    padding: 0.1em 0.4em;
    border-radius: var(--radius-sm);
  }

  /* Hero */
  .hero {
    padding-block: 48px;
    background-color: #111;
    background-size: cover;
    background-position: center;
    color: #fff;
    position: relative;
  }
  .hero__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .hero__logo {
    height: clamp(4rem, 8vw, 6.5rem);
    width: auto;
  }
  .hero__desc {
    color: #fff;
    font-size: clamp(0.9rem, 1.5vw + 0.3rem, var(--text-lg));
    letter-spacing: 0.02em;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
  }
  .hero__desc .brag-highlight {
    text-shadow: none;
  }

  /* Tabs */
  .tabs {
    margin-top: var(--space-4);
    margin-bottom: -48px;
    padding-bottom: 0;
  }
  .tabs__inner {
    display: flex;
    align-items: flex-end;
